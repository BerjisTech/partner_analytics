<p id="notice"><%= notice %></p>

<h1>Listing Apps</h1>

<table class="table table-responsive table-hover">
  <thead>
    <tr>
      <th>App name</th>
      <th>Shopify partner</th>
      <th>Shopify app</th>
      <th>Primary token</th>
      <th>Secondary token</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @apps.each do |app| %>
      <tr>
        <td><%= app.app_name %></td>
        <td><%= app.shopify_partner_id %></td>
        <td><%= app.shopify_app_id %></td>
        <td><%= app.primary_token %></td>
        <td><%= app.secondary_token %></td>
        <td><%= link_to 'Show', app %></td>
        <td><%= link_to 'Edit', edit_app_path(app) %></td>
        <td><%= link_to 'Destroy', app, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New App', new_app_path %>
