<p id="notice"><%= notice %></p>

<h1>Listing Apps</h1>

<table class="table table-responsive table-hover">
  <thead class="table-dark">
    <tr>
      <th scope="col">App name</th>
      <th scope="col">Shopify partner</th>
      <th scope="col">Shopify app</th>
      <th scope="col">Primary token</th>
      <th scope="col">Secondary token</th>
      <th scope="col" colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @apps.each do |app| %>
      <tr class="align-middle">
        <td class="align-middle"><%= app.app_name %></td>
        <td class="align-middle"><%= app.shopify_partner_id %></td>
        <td class="align-middle"><%= app.shopify_app_id %></td>
        <td class="align-middle"><%= app.primary_token %></td>
        <td class="align-middle"><%= app.secondary_token %></td>
        <td class="align-middle"><%= link_to "visibility", app, class: "material-icons nav-link btn btn-outline-info btn-sm" %></td>
        <td class="align-middle"><%= link_to "edit_note", edit_app_path(app.id), class: "material-icons nav-link btn btn-outline-primary btn-sm" %></td>
        <td class="align-middle"><%= link_to "delete", app, method: :delete, data: { confirm: "Are you sure?" }, class: "material-icons nav-link btn btn-outline-danger btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New App", new_app_path, class: "btn btn-outline-primary btn-md btn-hover" %>
